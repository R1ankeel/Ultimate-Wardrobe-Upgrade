<Page x:Class="UltimateWardrobe.App.Views.OverhaulView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:UltimateWardrobe.App.ViewModels"
      xmlns:views="clr-namespace:UltimateWardrobe.App.Views"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Title="Overhaul">

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <views:StringToSymbolConverter x:Key="Symbol" />
    <Style x:Key="MatrixCellCard" TargetType="Button">
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="Background" Value="#11FFFFFF" />
    </Style>
    <Style x:Key="MatrixRowName" TargetType="TextBlock">
      <Setter Property="MaxWidth" Value="220" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
  </Page.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Empty state -->
    <StackPanel Grid.Row="0"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="Overhaul" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding EmptyMessage}"
                 Margin="0,16,0,0"
                 Opacity="0.6" />
    </StackPanel>

    <StackPanel Grid.Row="0"
                Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
      <TextBlock Text="{Binding OverhaulName, FallbackValue=Overhaul}"
                 FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding ProgressLabel}"
                 Margin="0,4,0,0"
                 Opacity="0.7" FontSize="12" />

      <!-- Status legend (Sprint 6.6 polish): a WPF-UI symbol + text per matrix status, no emoji -->
      <ItemsControl ItemsSource="{Binding StatusLegend}"
                    Margin="0,10,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
              <ui:SymbolIcon Symbol="{Binding Symbol, Converter={StaticResource Symbol}}"
                             Foreground="#FF5BC0EB"
                             Margin="0,0,5,0" />
              <TextBlock Text="{Binding Label}" FontSize="12" Opacity="0.85" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Orientation="Horizontal" Margin="0,16,0,12">
        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 Width="260"
                 VerticalContentAlignment="Center" />
        <ComboBox ItemsSource="{Binding StatusOptions}"
                  SelectedItem="{Binding SelectedStatusOption}"
                  Width="160"
                  Margin="12,0,0,0"
                  VerticalAlignment="Center" />
      </StackPanel>

      <!-- Fixed header row (aligns with the per-row name column + weight columns) -->
      <Grid ColumnDefinitions="232,*">
        <TextBlock Text="Armor set"
                   FontWeight="SemiBold"
                   FontSize="12"
                   Opacity="0.7" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:MatrixColumnViewModel}">
              <TextBlock Text="{Binding Header}"
                         Width="160" Margin="2,0"
                         FontWeight="SemiBold"
                         FontSize="12"
                         Opacity="0.7" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </StackPanel>

    <!-- Matrix body: one flat virtualized list of section headers + row bands (Sprint 6.8 rework).
         A single VirtualizingStackPanel inside the scroll viewport realizes only on-screen rows, so a
         multi-thousand-row catalog no longer materializes the whole grid (manual-testing bug 3). The
         top margin keeps the vertical slider's grip clear of the window close button (bug 4). -->
    <ScrollViewer Grid.Row="2"
                  Margin="0,20,0,0"
                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}"
                  CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
      <ItemsControl ItemsSource="{Binding MatrixItems}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Resources>
          <DataTemplate DataType="{x:Type vm:MatrixSectionHeaderViewModel}">
            <TextBlock Text="{Binding Header}"
                       Margin="0,14,0,6"
                       FontWeight="SemiBold"
                       FontSize="16"
                       Opacity="0.9" />
          </DataTemplate>
          <!-- The row name is a clickable button (manual-testing bug 6): clicking an item opens the
               popover editor for its default (set, gender, weight) coordinate even before any mapping
               exists. The name wraps instead of truncating (manual-testing bug 5). -->
          <DataTemplate DataType="{x:Type vm:ArmorSetRowViewModel}">
            <Grid ColumnDefinitions="232,*">
              <Button Click="MatrixRow_Click"
                      Command="{Binding DataContext.ActivateCellCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                      CommandParameter="{Binding DefaultCell}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0,4,0,4"
                      HorizontalContentAlignment="Left"
                      ToolTip="{Binding DisplayName}">
                <TextBlock Text="{Binding DisplayName}"
                           Style="{StaticResource MatrixRowName}" />
              </Button>
              <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:MatrixCellViewModel}">
                    <Button Style="{StaticResource MatrixCellCard}"
                            Click="MatrixCell_Click"
                            Visibility="{Binding IsBlank, Converter={StaticResource InverseBoolToVis}}"
                            Command="{Binding DataContext.ActivateCellCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                            CommandParameter="{Binding}">
                      <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type vm:CellLineViewModel}">
                            <TextBlock Text="{Binding Text}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ItemsControl.Resources>
      </ItemsControl>
    </ScrollViewer>

    <!-- Anchored single-cell editor popover (Phase 6 Sprint 6.5). PlacementTarget is set from the
         clicked cell in code-behind; StaysOpen=false closes on outside click / focus loss; the VM
         clears the editor on Esc (routeEvent handled in PreviewKeyDown). -->
    <Popup x:Name="CellEditorPopup"
           Placement="Bottom"
           PlacementRectangle="0,0,8,8"
           AllowsTransparency="True"
           StaysOpen="False"
           IsOpen="{Binding IsEditorOpen, Mode=OneWay}">
      <Border Background="#FF202020"
              BorderBrush="#33FFFFFF"
              BorderThickness="1"
              CornerRadius="6"
              Padding="16"
              MinWidth="440"
              MaxWidth="640"
              MaxHeight="620">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="{Binding CellEditor.Title}"
                       FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="{Binding CellEditor.SetStatus}"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12" Opacity="0.7" />
            <Button Content="Import patch"
                    Margin="12,0,0,0"
                    Command="{Binding CellEditor.ImportPatchCommand}" />
          </StackPanel>

          <Grid ColumnDefinitions="280,*">
            <!-- ARMOR 1 - read-only target inventory (Sprint 6.9 T2) -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="ARMOR 1" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
              <TextBlock Text="Set to replace" FontSize="11" Opacity="0.6" Margin="0,2,0,10" />

              <ItemsControl ItemsSource="{Binding CellEditor.Rows}" Grid.IsSharedSizeScope="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:PieceInventoryRowViewModel}">
                    <Border BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1" Padding="0,6">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding EditorId}" FontWeight="SemiBold" FontSize="12" />
                          <TextBlock Text="{Binding Status}"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     FontSize="11" Opacity="0.7" />
                        </StackPanel>
                        <TextBlock Text="{Binding Slot}" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="{Binding TargetMesh}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                          <TextBlock Text="{Binding DonorBodyMarkerText, StringFormat='Body: {0}'}" FontSize="11" Opacity="0.7" />
                          <TextBlock Text="BodySlide" FontSize="11" Opacity="0.7" Margin="8,0,0,0"
                                     Visibility="{Binding HasBodySlide, Converter={StaticResource BoolToVis}}" />
                          <TextBlock Text="Physics" FontSize="11" Opacity="0.7" Margin="8,0,0,0"
                                     Visibility="{Binding HasPhysics, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- ARMOR 2 - the replacement mod (Sprint 6.9 T2) -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
              <TextBlock Text="ARMOR 2" FontWeight="SemiBold" FontSize="12" Opacity="0.8" />
              <TextBlock Text="Replacement mod" FontSize="11" Opacity="0.6" Margin="0,2,0,10" />

              <TextBlock Text="{Binding CellEditor.CurrentDonorText}"
                         FontWeight="SemiBold" FontSize="13" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ComboBox ItemsSource="{Binding CellEditor.AvailableDonors}"
                          SelectedItem="{Binding CellEditor.SelectedDonor}"
                          DisplayMemberPath="DisplayName"
                          MinWidth="180" />
                <Button Content="{Binding CellEditor.LoadDonorLabel}"
                        Margin="8,0,0,0"
                        Command="{Binding CellEditor.LoadDonorCommand}" />
              </StackPanel>

              <StackPanel Margin="0,18,0,0">
                <TextBlock Text="{Binding CellEditor.BodyCheckText}"
                           FontWeight="SemiBold" FontSize="12" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                            Visibility="{Binding CellEditor.ShowBodyPatchRow, Converter={StaticResource BoolToVis}}">
                  <ComboBox ItemsSource="{Binding CellEditor.BodyPatches}"
                            SelectedItem="{Binding CellEditor.SelectedBodyPatch}"
                            DisplayMemberPath="DisplayName"
                            MinWidth="180" />
                  <Button Content="{Binding CellEditor.LoadBodyPatchLabel}"
                          Margin="8,0,0,0"
                          Command="{Binding CellEditor.LoadBodyPatchCommand}" />
                </StackPanel>
                <Button Content="{Binding CellEditor.ClearBodyPatchLabel}"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding CellEditor.ShowClearBodyPatch, Converter={StaticResource BoolToVis}}"
                        Command="{Binding CellEditor.ClearBodyPatchCommand}" />

                <TextBlock Text="{Binding CellEditor.PhysicsCheckText}"
                           FontWeight="SemiBold" FontSize="12" Margin="0,14,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                            Visibility="{Binding CellEditor.ShowPhysicsPatchRow, Converter={StaticResource BoolToVis}}">
                  <ComboBox ItemsSource="{Binding CellEditor.PhysicsPatches}"
                            SelectedItem="{Binding CellEditor.SelectedPhysicsPatch}"
                            DisplayMemberPath="DisplayName"
                            MinWidth="180" />
                  <Button Content="Load HDT-SMP patch"
                          Margin="8,0,0,0"
                          Command="{Binding CellEditor.LoadPhysicsPatchCommand}" />
                </StackPanel>
                <Button Content="Clear HDT-SMP patch"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding CellEditor.ShowClearPhysicsPatch, Converter={StaticResource BoolToVis}}"
                        Command="{Binding CellEditor.ClearPhysicsPatchCommand}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Page>
