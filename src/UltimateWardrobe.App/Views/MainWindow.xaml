<ui:FluentWindow x:Class="UltimateWardrobe.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:UltimateWardrobe.App.Views"
                 mc:Ignorable="d"
                 Title="{Binding Title, FallbackValue=Ultimate Wardrobe}"
                 Height="760" Width="1180"
                 MinHeight="560" MinWidth="900"
                 WindowStartupLocation="CenterScreen">

  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <!-- In-content corner close button (Sprint 6.7 polish): a flat white "x" shown at the top-right
         when the OS title bar controls are not reachable. Declared as a window resource (not
         app-scope) so the shell still builds headless without an Application instance. -->
    <Style x:Key="CornerCloseButton" TargetType="Button">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="0,6,6,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#33FFFFFF" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#4DFFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:NavigationView x:Name="RootNavigation"
                       Grid.Row="0"
                       PaneDisplayMode="Left"
                       IsBackButtonVisible="Collapsed"
                       OpenPaneLength="220"
                       HeaderVisibility="Collapsed">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Project"
                               TargetPageType="{x:Type views:ProjectView}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Home24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Overhaul"
                               TargetPageType="{x:Type views:OverhaulView}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="GridDots24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Donor library"
                               TargetPageType="{x:Type views:DonorLibraryView}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="FolderOpen24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Export"
                               TargetPageType="{x:Type views:ExportView}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Save24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>

      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem>
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="DarkTheme24" />
          </ui:NavigationViewItem.Icon>
          <Button Content="{Binding ThemeLabel}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Command="{Binding ToggleThemeCommand}" />
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>

    <Border Grid.Row="1"
            BorderThickness="0,1,0,0"
            BorderBrush="#33FFFFFF"
            Padding="12,4"
            Background="#0DFFFFFF">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ui:ProgressRing Grid.Column="0"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0"
                         Width="18" Height="18"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Text="{Binding StatusText, FallbackValue=Ready}"
                   TextTrimming="CharacterEllipsis" />

        <ui:Button Grid.Column="2"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"
                   Padding="10,3"
                   Content="Cancel"
                   Command="{Binding CancelCommand}" />
      </Grid>
    </Border>

    <Button Grid.Row="0"
            Style="{StaticResource CornerCloseButton}"
            Click="OnCloseClicked"
            ToolTip="Close">
      <ui:SymbolIcon Symbol="Dismiss24" Foreground="#FFFFFFFF" Width="18" Height="18" />
    </Button>

    <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="0" />
  </Grid>
</ui:FluentWindow>
