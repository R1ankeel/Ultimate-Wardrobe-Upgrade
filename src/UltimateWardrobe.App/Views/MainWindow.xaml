<ui:FluentWindow x:Class="UltimateWardrobe.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:UltimateWardrobe.App.Views"
                 mc:Ignorable="d"
                 Title="{Binding Title, FallbackValue=Ultimate Wardrobe}"
                 Icon="{StaticResource AppIcon}"
                 Height="760" Width="1180"
                 MinHeight="560" MinWidth="900"
                 WindowStartupLocation="CenterScreen">

  <ui:FluentWindow.Resources>
    <!-- App icon (Sprint 6.6 polish, roadmap 8.5): a simple wardrobe-door vector, resident at runtime. -->
    <DrawingImage x:Key="AppIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FF3D5C7A">
            <GeometryDrawing.Geometry>
              <RectangleGeometry Rect="0,0,16,16" RadiusX="1.5" RadiusY="1.5" />
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#FFFFFFFF">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <RectangleGeometry Rect="3,2,1.5,12" RadiusX="0.6" RadiusY="0.6" />
                <RectangleGeometry Rect="11.5,2,1.5,12" RadiusX="0.6" RadiusY="0.6" />
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#FFE2BE5A">
            <GeometryDrawing.Geometry>
              <GeometryGroup>
                <RectangleGeometry Rect="2,7.4,0.8,1.2" RadiusX="0.3" RadiusY="0.3" />
                <RectangleGeometry Rect="13.2,7.4,0.8,1.2" RadiusX="0.3" RadiusY="0.3" />
              </GeometryGroup>
            </GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ui:NavigationView x:Name="RootNavigation"
                       Grid.Row="0"
                       PaneDisplayMode="Left"
                       IsBackButtonVisible="Collapsed"
                       OpenPaneLength="220"
                       HeaderVisibility="Collapsed">
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Content="Project"
                               TargetPageType="{x:Type views:ProjectView}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Home24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Overhaul"
                               TargetPageType="{x:Type views:OverhaulView}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="GridDots24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Donor library"
                               TargetPageType="{x:Type views:DonorLibraryView}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="FolderOpen24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Content="Export"
                               TargetPageType="{x:Type views:ExportView}">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Save24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>

      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem>
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="DarkTheme24" />
          </ui:NavigationViewItem.Icon>
          <Button Content="{Binding ThemeLabel}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Command="{Binding ToggleThemeCommand}" />
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>

    <Border Grid.Row="1"
            BorderThickness="0,1,0,0"
            BorderBrush="#33FFFFFF"
            Padding="12,4"
            Background="#0DFFFFFF">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ui:ProgressRing Grid.Column="0"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0"
                         Width="18" Height="18"
                         IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Text="{Binding StatusText, FallbackValue=Ready}"
                   TextTrimming="CharacterEllipsis" />

        <ui:Button Grid.Column="2"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"
                   Padding="10,3"
                   Content="Cancel"
                   Command="{Binding CancelCommand}" />
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
