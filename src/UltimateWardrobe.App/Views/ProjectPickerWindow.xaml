<ui:FluentWindow x:Class="UltimateWardrobe.App.Views.ProjectPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="Ultimate Wardrobe - Open Project"
                 Height="520" Width="640"
                 MinHeight="420" MinWidth="520"
                 WindowStartupLocation="CenterScreen">

  <ui:FluentWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </ui:FluentWindow.Resources>

  <Grid Margin="24" RowDefinitions="Auto,Auto,*,Auto,20,Auto">
    <TextBlock Grid.Row="0"
               FontSize="22"
               FontWeight="SemiBold"
               Text="Ultimate Wardrobe"
               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

    <TextBlock Grid.Row="1"
               Opacity="0.7"
               Text="Pick or create the single project to work in. One project per session." />

    <StackPanel Grid.Row="2" Margin="0,16,0,0">
      <TextBlock Text="Recent projects" FontWeight="SemiBold" Margin="0,0,0,8" />
      <ui:ListView ItemsSource="{Binding RecentProjects}"
                   SelectedItem="{Binding SelectedRecent}"
                   BorderThickness="0"
                   Height="220"
                   DisplayMemberPath="Name">
        <ui:ListView.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Path}" Opacity="0.6" FontSize="11" />
            </StackPanel>
          </DataTemplate>
        </ui:ListView.ItemTemplate>
      </ui:ListView>
    </StackPanel>

    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:Button Grid.Column="1" Content="New project" Command="{Binding NewProjectCommand}" Icon="{ui:SymbolIcon Add24}" />
      <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Open project" Command="{Binding OpenProjectCommand}" Icon="{ui:SymbolIcon FolderOpen24}" />
      <ui:Button Grid.Column="3" Margin="8,0,0,0" Content="Open selected" Command="{Binding OpenSelectedRecentCommand}" Appearance="Primary" />
    </Grid>

    <ui:ProgressRing Grid.Row="4"
                     Width="20" Height="20"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
  </Grid>
</ui:FluentWindow>
