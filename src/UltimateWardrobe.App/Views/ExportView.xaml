<Page x:Class="UltimateWardrobe.App.Views.ExportView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:views="clr-namespace:UltimateWardrobe.App.Views"
      mc:Ignorable="d"
      Title="Export">

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <Style x:Key="PathText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ChecklistItem" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="Background" Value="#11FFFFFF" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Empty state -->
    <StackPanel Grid.Row="0"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="Export" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding EmptyMessage}"
                 Margin="0,16,0,0"
                 Opacity="0.6" />
    </StackPanel>

    <!-- Export content -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
      <StackPanel>
        <TextBlock Text="{Binding OverhaulName, FallbackValue=Export}"
                   FontSize="24" FontWeight="SemiBold" />

        <!-- Pre-export checklist -->
        <TextBlock Text="Pre-export checklist"
                   FontWeight="SemiBold" FontSize="14"
                   Margin="0,20,0,10" Opacity="0.9" />
        <StackPanel Orientation="Horizontal">
          <Border Style="{StaticResource ChecklistItem}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="CheckmarkCircle24" Foreground="#FF6CCB5F" Margin="0,0,6,0" />
              <TextBlock Text="{Binding SetsDone}" FontWeight="SemiBold" />
              <TextBlock Text=" done" Opacity="0.7" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ChecklistItem}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="GridDots24" Foreground="#FF5BC0EB" Margin="0,0,6,0" />
              <TextBlock Text="{Binding SetsReady}" FontWeight="SemiBold" />
              <TextBlock Text=" ready" Opacity="0.7" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ChecklistItem}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Warning24" Foreground="#FFE2BE5A" Margin="0,0,6,0" />
              <TextBlock Text="{Binding SetsNeedsPatch}" FontWeight="SemiBold" />
              <TextBlock Text=" need patch" Opacity="0.7" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ChecklistItem}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Clock24" Foreground="#FFD88EF8" Margin="0,0,6,0" />
              <TextBlock Text="{Binding SetsInProgress}" FontWeight="SemiBold" />
              <TextBlock Text=" in progress" Opacity="0.7" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ChecklistItem}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Circle20" Foreground="#FF9E9E9E" Margin="0,0,6,0" />
              <TextBlock Text="{Binding SetsNotStarted}" FontWeight="SemiBold" />
              <TextBlock Text=" not started" Opacity="0.7" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource ChecklistItem}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding TotalSets}" FontWeight="SemiBold" />
              <TextBlock Text=" total sets" Opacity="0.7" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Allow partial + output folder -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
          <CheckBox VerticalAlignment="Center"
                    IsChecked="{Binding AllowPartial}"
                    Content="Allow partial export (export even if some sets are unfinished)" />
        </StackPanel>
        <TextBlock Text="{Binding AllowPartialHint}"
                   FontSize="11" Opacity="0.6" Margin="2,4,0,0"
                   Visibility="{Binding AllowPartial, Converter={StaticResource InverseBoolToVis}}" />

        <StackPanel Margin="0,16,0,0">
          <TextBlock Text="Output folder" FontSize="12" Opacity="0.8" />
          <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                   MinWidth="420"
                   FontFamily="Consolas"
                   Margin="0,4,0,0" />
        </StackPanel>

        <!-- Progress + cancel (only while building) -->
        <StackPanel Margin="0,20,0,0"
                    Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding CurrentStage, FallbackValue=Starting}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding ProgressPercent, StringFormat=' {0:0}%'}" Opacity="0.7" Margin="8,0,0,0" />
          </StackPanel>
          <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                       Value="{Binding ProgressPercent, Mode=OneWay}" />
          <TextBlock Text="{Binding ProgressDetail}"
                     FontSize="11" Opacity="0.6" Margin="0,6,0,0"
                     TextTrimming="CharacterEllipsis" />
          <ui:Button Content="Cancel" Command="{Binding CancelBuildCommand}"
                     Margin="0,12,0,0" Padding="16,8" />
        </StackPanel>

        <!-- Primary action: build or re-export (auto-disables while building) -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
          <ui:Button Content="{Binding BuildButtonLabel, FallbackValue=Собрать гардероб}"
                     Command="{Binding BuildCommand}"
                     Appearance="Primary" Padding="16,8" />
        </StackPanel>

        <!-- Result card -->
        <Border Margin="0,24,0,0"
                CornerRadius="6"
                Background="#12000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                Padding="16"
                Visibility="{Binding IsResultVisible, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock Text="Export result" FontWeight="SemiBold" FontSize="16" />
            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="Mod folder" FontSize="11" Opacity="0.7" />
              <TextBlock Text="{Binding ResultModFolder}" Style="{StaticResource PathText}" />
            </StackPanel>
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="Plugin" FontSize="11" Opacity="0.7" />
              <TextBlock Text="{Binding ResultPluginPath}" Style="{StaticResource PathText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <StackPanel Margin="0,0,28,0">
                <TextBlock Text="{Binding OverriddenRecords}" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="records overridden" FontSize="11" Opacity="0.7" />
              </StackPanel>
              <StackPanel Margin="0,0,28,0">
                <TextBlock Text="{Binding CopiedFilesCount}" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="files copied" FontSize="11" Opacity="0.7" />
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{Binding CopiedBytesText}" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="bytes copied" FontSize="11" Opacity="0.7" />
              </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="Warnings" FontWeight="SemiBold" FontSize="12" />
              <ItemsControl ItemsSource="{Binding ResultWarnings}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,2,0,0">
                      <TextBlock FontFamily="Consolas" FontSize="11" Opacity="0.9">
                        <Run Text="{Binding Context, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <ui:Button Content="Open in Explorer"
                       Command="{Binding OpenInExplorerCommand}"
                       Margin="0,14,0,0" Padding="16,8" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
