<Page x:Class="UltimateWardrobe.App.Views.DonorLibraryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="clr-namespace:UltimateWardrobe.App.ViewModels"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      Title="Donor library">

  <Page.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <Style x:Key="RowButton" TargetType="Button">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="6,0,0,0" />
    </Style>
    <Style x:Key="IndicatorBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0"
               Text="Donor library"
               FontSize="24" FontWeight="SemiBold" />

    <Border Grid.Row="1"
            Margin="0,16,0,12"
            Padding="16"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="#33FFFFFF"
            Background="#0DFFFFFF"
            AllowDrop="True"
            Drop="OnDrop">
      <StackPanel>
        <TextBlock Text="Drop .7z / .zip / .rar archives here to import donors"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Each archive is extracted, classified and appended to the library."
                   Opacity="0.7"
                   FontSize="12"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2" Margin="0,0,0,12"
                Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding ProgressText, FallbackValue=Importing...}" />
      <ProgressBar Minimum="0"
                   Maximum="{Binding ProgressTotal, FallbackValue=1}"
                   Value="{Binding ProgressValue, Mode=OneWay}"
                   Height="6" Margin="0,6,0,0" />
    </StackPanel>

    <ui:ListView Grid.Row="3"
                 ItemsSource="{Binding Donors}"
                 BorderThickness="1"
                 Margin="0,0,0,0">
      <ui:ListView.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:DonorRowViewModel}">
          <Grid Margin="4,6" ColumnDefinitions="*,Auto">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding OriginalFileName}" FontWeight="SemiBold" />
                <Border Style="{StaticResource IndicatorBadge}" Background="#22FFFFFF">
                  <TextBlock Text="{Binding KindText}" FontSize="11" Opacity="0.9" />
                </Border>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Opacity="0.8">
                <TextBlock Text="{Binding ProvidedSetsCount, StringFormat={}{0} provided sets}" />
                <TextBlock Text="  -  " />
                <TextBlock Text="{Binding ImportDate}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Border Style="{StaticResource IndicatorBadge}" Background="#FF7BC67E"
                        Visibility="{Binding HasThreeBA, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="3BA" FontSize="11" />
                </Border>
                <Border Style="{StaticResource IndicatorBadge}" Background="#FF7BA7C6"
                        Visibility="{Binding HasHimbo, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="HIMBO" FontSize="11" />
                </Border>
                <Border Style="{StaticResource IndicatorBadge}" Background="#FF3D7A4A"
                        Visibility="{Binding HasBodySlide, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="BodySlide" FontSize="11" />
                </Border>
                <Border Style="{StaticResource IndicatorBadge}" Background="#FF3D5C7A"
                        Visibility="{Binding HasPhysics, Converter={StaticResource BoolToVis}}">
                  <TextBlock Text="HDT-SMP" FontSize="11" />
                </Border>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <ui:Button Content="Kind"
                         Command="{Binding DataContext.SetKindCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                         CommandParameter="{Binding}" />
              <ui:Button Content="Reclassify"
                         Style="{StaticResource RowButton}"
                         Command="{Binding DataContext.ReclassifyCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                         CommandParameter="{Binding}" />
              <ui:Button Content="Remove"
                         Style="{StaticResource RowButton}"
                         Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                         CommandParameter="{Binding}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ui:ListView.ItemTemplate>
    </ui:ListView>
  </Grid>
</Page>
